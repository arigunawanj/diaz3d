generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Submission {
  id             String    @id @default(cuid())
  code           String    @unique
  token          String    @unique
  name           String
  wa             String
  eventDate      String
  location       String
  notes          String    @default("")
  designJson     String
  linesJson      String
  estimate       Int
  finalLinesJson String?
  finalPrice     Int?
  /// MENUNGGU | DISETUJUI | DIREVISI
  status         String    @default("MENUNGGU")
  adminNote      String    @default("")
  screenshot     String?
  waSentAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CatalogItem {
  id       String  @id
  name     String
  category String
  price    Int
  unit     String
  active   Boolean @default(true)
}

model Setting {
  key   String @id
  value String
}
